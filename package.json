{
  "name": "@yoke233/omdsh",
  "description": "OMP-styled interactive terminal profile bundle for DeepSeek Harness",
  "version": "0.6.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoke233/omdsh.git"
  },
  "homepage": "https://github.com/yoke233/omdsh#readme",
  "bugs": {
    "url": "https://github.com/yoke233/omdsh/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "terminal-ui",
    "tui",
    "omp"
  ],
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test --experimental-transform-types \"tests/*.spec.ts\"",
    "check": "pnpm run typecheck && pnpm run test",
    "generate:themes": "node scripts/generate-omp-themes.mjs",
    "build": "tsc -b && tsdown",
    "prepare": "tsdown --config tsdown.prepare.config.ts",
    "version:patch": "pnpm version patch --no-git-tag-version --no-git-checks"
  },
  "main": "lib/index.js",
  "bin": {
    "omdsh": "scripts/omdsh.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./reload": "./lib/reload.js",
    "./startup": "./lib/startup.js",
    "./prompt": "./lib/prompt.js",
    "./session-title": "./lib/session-title.js",
    "./llm-tool-call-sanitizer": "./lib/llm-tool-call-sanitizer.js",
    "./wechat": "./lib/wechat/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "docs/INSTALL.md",
    "docs/hooks.md",
    "docs/orca.md",
    "docs/examples/hooks.example.json",
    "lib/*.js",
    "lib/wechat",
    "scripts/omdsh",
    "scripts/omdsh.cmd",
    "scripts/omdsh.js",
    "scripts/omdsh-update.js",
    "src",
    "cordis.patch.yml"
  ],
